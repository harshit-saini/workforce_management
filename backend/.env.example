DATABASE_URL=postgresql://wms:wms@localhost:5432/wms
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
PORT=4000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
# Optional: S3-compatible object storage for attachments (recommended in production —
# local disk on most free hosts is wiped on redeploy/restart). Works with Cloudflare R2,
# AWS S3, Backblaze B2, MinIO, etc. Leave all four unset to use local disk instead.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=wms-attachments
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL_BASE=https://pub-xxxxxxxx.r2.dev
CORS_ORIGIN=http://localhost:5173
WEEKLY_REPORT_DEADLINE_CRON=0 12 * * 1
REMINDER_SCAN_CRON=0 * * * *
